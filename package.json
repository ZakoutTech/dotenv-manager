{
  "name": "dotenv-manager",
  "displayName": "Dotenv Manager",
  "description": "Visual editor for .env files: groups, comments, drag-and-drop ordering, alphabetical sorting and ${VAR} references.",
  "version": "0.0.1",
  "publisher": "zakout",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "dotenv",
    "env",
    ".env",
    "environment variables"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:dotenv",
    "workspaceContains:**/.env",
    "workspaceContains:**/.env.*",
    "workspaceContains:**/*.env"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "dotenvManager.editor",
        "displayName": "Dotenv Manager",
        "selector": [
          {
            "filenamePattern": ".env"
          },
          {
            "filenamePattern": ".env.*"
          },
          {
            "filenamePattern": "*.env"
          },
          {
            "filenamePattern": "*.env.*"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Dotenv Manager",
      "properties": {
        "dotenvManager.envFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".env",
            ".env.local",
            ".env.development",
            ".env.production",
            ".env.test",
            ".env.example"
          ],
          "uniqueItems": true,
          "markdownDescription": "File names Dotenv Manager detects. Only these files are listed and counted, and offer **Open with Dotenv Manager**; every other file is ignored. Names only (no folders); `*`, `?`, `{a,b}` and `[abc]` are supported, e.g. `.env.*.local`."
        },
        "dotenvManager.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules",
            "**/.git",
            "**/dist",
            "**/out",
            "**/build",
            "**/.next",
            "**/coverage",
            "**/vendor"
          ],
          "order": 2,
          "markdownDescription": "Glob patterns (relative to the workspace folder) for folders and files that are not searched for `.env` files. A pattern without `/` matches that name at any depth (`vendor` is the same as `**/vendor`). Supports `**`, `*`, `?`, `{a,b}` and `[abc]`."
        },
        "dotenvManager.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "Show the Dotenv Manager item (with the number of .env files in the workspace) in the status bar."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "dotenvManager.files",
          "name": "Dotenv Files",
          "icon": "images/editor-dark.svg",
          "contextualTitle": "Dotenv Manager"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dotenvManager.files",
        "contents": "No .env files found in this workspace.\n[Create .env File](command:dotenvManager.createEnvFile)\n[Search again](command:dotenvManager.refreshEnvFiles)"
      }
    ],
    "commands": [
      {
        "command": "dotenvManager.openEditor",
        "title": "Open with Dotenv Manager",
        "category": "Dotenv Manager",
        "icon": {
          "light": "images/editor-light.svg",
          "dark": "images/editor-dark.svg"
        }
      },
      {
        "command": "dotenvManager.openText",
        "title": "Open as Text",
        "category": "Dotenv Manager",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dotenvManager.selectEnvFile",
        "title": "Select .env File",
        "category": "Dotenv Manager",
        "icon": "$(list-selection)"
      },
      {
        "command": "dotenvManager.createEnvFile",
        "title": "Create .env File…",
        "category": "Dotenv Manager",
        "icon": "$(new-file)"
      },
      {
        "command": "dotenvManager.refreshEnvFiles",
        "title": "Refresh .env Files",
        "category": "Dotenv Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "dotenvManager.sortAll",
        "title": "Sort All Groups A→Z",
        "category": "Dotenv Manager"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dotenvManager.openText",
          "when": "activeCustomEditorId == 'dotenvManager.editor'"
        },
        {
          "command": "dotenvManager.openEditor",
          "when": "resourceFilename in dotenvManager.envFileNames"
        },
        {
          "command": "dotenvManager.sortAll",
          "when": "resourceFilename in dotenvManager.envFileNames || activeCustomEditorId == 'dotenvManager.editor'"
        }
      ],
      "view/title": [
        {
          "command": "dotenvManager.createEnvFile",
          "when": "view == dotenvManager.files",
          "group": "navigation@0"
        },
        {
          "command": "dotenvManager.selectEnvFile",
          "when": "view == dotenvManager.files",
          "group": "navigation@1"
        },
        {
          "command": "dotenvManager.refreshEnvFiles",
          "when": "view == dotenvManager.files",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dotenvManager.createEnvFile",
          "when": "view == dotenvManager.files && viewItem == dotenvManager.folder",
          "group": "inline"
        },
        {
          "command": "dotenvManager.openEditor",
          "when": "view == dotenvManager.files && viewItem == dotenvManager.envFile",
          "group": "inline@1"
        },
        {
          "command": "dotenvManager.openText",
          "when": "view == dotenvManager.files && viewItem == dotenvManager.envFile",
          "group": "inline@2"
        },
        {
          "command": "dotenvManager.openEditor",
          "when": "view == dotenvManager.files && viewItem == dotenvManager.envFile",
          "group": "1_open@1"
        },
        {
          "command": "dotenvManager.openText",
          "when": "view == dotenvManager.files && viewItem == dotenvManager.envFile",
          "group": "1_open@2"
        },
        {
          "command": "dotenvManager.sortAll",
          "when": "view == dotenvManager.files && viewItem == dotenvManager.envFile",
          "group": "2_edit"
        }
      ],
      "explorer/context": [
        {
          "command": "dotenvManager.createEnvFile",
          "when": "explorerResourceIsFolder",
          "group": "navigation@11"
        },
        {
          "command": "dotenvManager.openEditor",
          "when": "resourceFilename in dotenvManager.envFileNames && !explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ],
      "editor/title/context": [
        {
          "command": "dotenvManager.openText",
          "when": "activeCustomEditorId == 'dotenvManager.editor'",
          "group": "1_open"
        },
        {
          "command": "dotenvManager.openEditor",
          "when": "resourceFilename in dotenvManager.envFileNames",
          "group": "1_open"
        }
      ],
      "editor/title": [
        {
          "command": "dotenvManager.openText",
          "when": "activeCustomEditorId == 'dotenvManager.editor'",
          "group": "navigation"
        },
        {
          "command": "dotenvManager.openEditor",
          "when": "resourceFilename in dotenvManager.envFileNames && activeCustomEditorId != 'dotenvManager.editor'",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "node scripts/preview.mjs",
    "install:cursor": "npm run package && node scripts/install-extension.mjs cursor",
    "install:code": "npm run package && node scripts/install-extension.mjs code",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "npm run build && tsc -p tsconfig.integration.json",
    "test:integration": "vscode-test",
    "vscode:prepublish": "tsdown --minify",
    "package": "vsce package --allow-missing-repository --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.140.0",
    "@vitest/coverage-v8": "^5.0.4",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "happy-dom": "^21.0.1",
    "mocha": "^12.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.1",
    "typescript": "~7.0.2",
    "vitest": "^5.0.4"
  }
}
